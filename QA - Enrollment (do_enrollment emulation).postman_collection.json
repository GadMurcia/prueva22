              "function generarPersona() {",
              "    const genero = Math.random() < 0.5 ? \"F\" : \"M\";",
              "    const nombres = genero === \"F\" ? obtenerDosDistintos(nombresFemeninos) : obtenerDosDistintos(nombresMasculinos);",
              "    const apellidos = obtenerDosDistintos(apellidosComunes);",
              "",
              "    const id = Math.floor(10000000 + Math.random() * 90000000).toString();",
              "    const direccion = `Calle ${Math.floor(Math.random() * 1000)} #${Math.floor(Math.random() * 100)}`;",
              "    const telefono = `+503 ${Math.floor(60000000 + Math.random() * 39999999)}`;",
              "",
              "    return {",
              "        genero,",
              "        nombres: `${nombres[0]} ${nombres[1]}`,",
              "        apellidos: `${apellidos[0]} ${apellidos[1]}`,",
              "        ID: id,",
              "        direccion,",
              "        correo: null,",
              "        telefono",
              "    };",
              "}",
              "",
