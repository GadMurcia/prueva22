              "const secondName = (persona.nombres && persona.nombres.split(' ')[1]) || 'Segundo';",
              "const secondLastName = (persona.apellidos && persona.apellidos.split(' ')[1]) || 'SegundoApellido';",
              "const email = generateRandomEmail(normalizarTexto(givenName));",
              "const gender = persona.genero || null; // \"M\" / \"F\"",
