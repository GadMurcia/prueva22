              "// ===== Helper functions =====",
              "function obtenerDosDistintos(lista) {",
              "    let primero, segundo;",
              "    do {",
              "        primero = lista[Math.floor(Math.random() * lista.length)];",
              "        segundo = lista[Math.floor(Math.random() * lista.length)];",
              "    } while (primero === segundo);",
              "    return [primero, segundo];",
              "}",
              "",
              "function normalizarTexto(texto) {",
              "    return texto",
              "        .normalize(\"NFD\")",
              "        .replace(/[\\u0300-\\u036f]/g, \"\")",
              "        .replace(/\\s+/g, \"_\")",
              "        .toLowerCase();",
              "}",
              "",
              "function generateRandomEmail(firstName) {",
              "    const rdm_id = Date.now();",
              "    const randomNumber = Math.floor(Math.random() * 1000000);",
              "    const randomString = Math.random().toString(36).substring(2, 8);",
              "    return `${firstName}${rdm_id}_${randomNumber}${randomString}@lifemiles.com`;",
              "}",
              "",
